<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Book Details</title>
    <link rel="stylesheet" href="/css/style2.css">
    
</head>
<body>
   
     <%- include('../partials/navbar') %>
     
    <h1>Book Details</h1>
    <div class="bookDetails">
    <% if (user._id == books.owner) { %>
        <h3><%= books.title %></h3>
        <img src="<%= books.Cover %>" width="200">
        <p>By <%= books.Author %></p>
        <p>Type : <%= books.Type %></p>
        <p>Status: <%= books.StatusRightnow %></p>
        <p>Summary: <%= books.Summary %></p>
        

        <% if (books.Reviews) { %>
            <p>Rating: <%= books.Reviews.Rating %> Out of 5</p>
            <p>Review: <%= books.Reviews.reviewText %></p>
        <% } %>

        <div class="linkBtn">
            <% if (String(books.StatusRightnow) === 'Finished Reading' && !books.Reviews) { %>
                <a href="/reviews/<%= books._id %>/newReview">Write A Review</a>
            <% } else if (books.Reviews) { %>
                <a href="/reviews/<%= books.Reviews._id %>/edit">Edit Review</a>
                <form action="/reviews/<%= books.Reviews._id %>?_method=DELETE" method="POST" onsubmit="return confirm('Delete this Review? This cannot be undone.')">
                    <button type="submit">Delete Review</button>
                </form>
            <% } %>

            <a href="/books/<%= books._id %>/edit">Update Your Book</a>
            <form action="/books/<%= books._id %>?_method=DELETE" method="POST" onsubmit="return confirm('Delete this Book? This cannot be undone.')">
                <button type="submit">Delete Book</button>
            </form>
        </div>
    <% } %>
</div>
</body>
</html>