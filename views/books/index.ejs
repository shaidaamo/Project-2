<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <%- include('../partials/navbar') %>
    <h1>All Books Availabe</h1>
    <% for(let oneBook of books){ %>
        <h3><%= oneBook.title %> </h3>
        <img src="<%= oneBook.Cover %>" width="200">
        <p>By <%= oneBook.Author %></p>
        <p>Summary: <%= oneBook.Summary %> </p>
        <p>Status: <%= oneBook.Status %></p>
        <% if(String(oneBook.Status) === 'Finished Reading'){ %>
            <a href="/books/<%= oneBook._id %>/newReview">Write A Review</a>
        <% } %>

    <% } %>

</body>
</html>