<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <%- include('../partials/navbar') %>
    <h1>All Books</h1>
   
    <% for(let oneBook of books){ %>
         <% if(user._id == oneBook.owner){ %>
        <h3><%= oneBook.title %> </h3>
        <img src="<%= oneBook.Cover %>" width="200">
        <p>By <%= oneBook.Author %></p>
        <p>Summary: <%= oneBook.Summary %> </p>
        <% if(user._id == oneBook.owner){ %> 
        <p>Status: <%= oneBook.StatusRightnow %></p>
        <% if(String(oneBook.StatusRightnow) === 'Finished Reading' && !oneBook.Reviews){ %>
            <a href="/reviews/<%= oneBook._id %>/newReview">Write A Review</a>
            <% } else if (oneBook.Reviews) { %>
    <a href="/reviews/<%= oneBook.Reviews._id %>/edit">Edit Review</a>
<% } %>
            <br>
             <form action="/books/<%= oneBook._id %>?_method=DELETE" method="post">
                <button>Delete Book</button>
            </form>
        <% } %>
        <br>
        <a href="/books/<%= oneBook._id %>/edit">Update Your Book</a>
    <% } %>
<% } %>
</body>
</html>