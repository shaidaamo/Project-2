<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
     <%- include('../partials/navbar') %>
     <h1> Books & Reviews</h1>
    <% for(let oneBook of allbooks){ %>
        <h3><%= oneBook.title %> </h3>
        <img src="<%= oneBook.Cover %>" width="200">
        <p>By <%= oneBook.Author %></p>
        <p>Rating: <%= oneBook.Reviews.Rating %> Out of 5</p>
        <p>Review: <%= oneBook.Reviews.reviewText %> By <%= user.username %></p>
        
        <% if(oneBook.owner._id == user._id){ %>
         <form action="/reviews/<%= oneBook.Reviews._id %>?_method=DELETE" method="POST">
            <button type="submit">Delete Review</button>
        </form>
        <% } %>
        <% } %>
</body>
</html>