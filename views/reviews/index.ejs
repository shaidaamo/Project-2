<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script defer src="../js/search-bar.js"></script>
    <title>Document</title>
    <link rel="stylesheet" href="../css/style2.css">
</head>
<body>
     <%- include('../partials/navbar') %>
     <h1> Books & Reviews</h1>
     <div class="searchbar">
        <input placeholder="Search Title, Author..." type="search" name="search" id="search-bar">
    </div>
        <div class="book-container">
        <% for(let oneBook of allbooks){ %>
        <div class="book">
        <h3><%= oneBook.title %> </h3>
        <img src="<%= oneBook.Cover %>" width="200">
        <div id="author">
        <p>By <%= oneBook.Author %></p>
        </div>
        <p>Rating: <%= oneBook.Reviews.Rating %> Out of 5</p>
        <p>Review: <%= oneBook.Reviews.reviewText %>  By <%= oneBook.Reviews.owner.username %></p>
        
        <% if(oneBook.owner._id == user._id){ %>
              <a href="/reviews/<%= oneBook.Reviews._id %>/edit">Edit Review</a>
         <form action="/reviews/<%= oneBook.Reviews._id %>?_method=DELETE" method="POST">
            <button type="submit">Delete Review</button>
        </form>
        <% } %>
        </div>
        <% } %>
    </div>
</body>
</html>